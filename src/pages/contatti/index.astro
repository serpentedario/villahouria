---
import Layout from "../../components/Layout.astro";
---
<Layout
  title="Contatti"
  path="/contatti/"
  description="Contatti Villa Houria — Sovramonte (Bellunese)."
>
  <section class="section">
    <div class="container">
      <div class="kicker">Contatti</div>
      <h1 class="sectionTitle" style="font-size:40px;margin-top:8px">Contatti</h1>
      <div class="cards" style="grid-template-columns:1fr 1fr">
        <div class="card">
          <h2 class="cardTitle">Scrivici</h2>
          <p class="cardP">Inserisci qui email/telefono. Se vuoi, posso aggiungere un form “Contatti” separato da “Prenota”.</p>
        </div>
        <div class="card">
          <h2 class="cardTitle">Dove</h2>
          <p class="cardP">Sovramonte (Bellunese). Aggiungeremo mappa e indicazioni senza appesantire la pagina.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

